{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "findqcs-store",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "findqcs.store", "custom_domain": true },
    { "pattern": "www.findqcs.store", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
