---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Catalog from '../components/Catalog.astro';
import Articles from '../components/Articles.astro';
import Product from '../components/Product.astro';
import PriorityGuides from '../components/PriorityGuides.astro';
import {relatedArticles} from '../lib/editorial';
import catalog from '../data/catalog-summary.json';
import oldCatalog from '../data/catalog.json';
import sources from '../data/sources.json';
import en from '../data/locales/en.json';
import {text,content,pathFor,languages,type Language} from '../data/i18n';
const oldSlugs=['using-the-spreadsheet','checking-qc-photos','understanding-costs','finding-your-size'];
export function getStaticPaths(){const old=['using-the-spreadsheet','checking-qc-photos','understanding-costs','finding-your-size'];const pages=['','spreadsheet','product','how-it-works','guides','articles','faq','image-search',...en.articles.map(a=>'articles/'+a.slug),...old.map(s=>'guides/'+s)];return languages.flatMap(lang=>[...pages,...((lang==='en'||lang==='nl')?oldCatalog.products.map(p=>'product/'+p.recordId):[])].map(page=>({params:{path:[lang==='en'?'':lang,page].filter(Boolean).join('/')||undefined},props:{lang,page}})));}
const {lang,page}=Astro.props as {lang:Language,page:string},t=text[lang],data=content[lang],p=(s='')=>pathFor(lang,s);
const legacyIndex=oldSlugs.indexOf(page.split('/')[1]);const legacyMap=[0,2,8,5];const article=page.startsWith('articles/')?data.articles.find((a:any)=>a.slug===page.split('/')[1]):page.startsWith('guides/')?data.articles[legacyMap[legacyIndex]]:undefined;
const title=article?article.title:page==='faq'?`LoloBuy FAQ | ${t.faqTitle}`:page==='articles'?t.articlesTitle:page==='guides'?t.guidesTitle:page==='how-it-works'?t.guideMetaTitle:page==='image-search'?t.photoTitle:page==='spreadsheet'?t.catalogTitle:t.homeTitle;
const description=article?.description|| (page==='faq'?t.faqIntro:page==='articles'?t.articlesIntro:page==='guides'?t.guidesSub:page==='how-it-works'?t.guideIntro:page==='spreadsheet'?t.catalogDescription:t.intro);
const official=(ids:string[])=>sources.filter(s=>ids.includes(s.id));
const structured=page==='faq'?{'@context':'https://schema.org','@type':'FAQPage',inLanguage:lang,mainEntity:data.faqs.map((f:any)=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}:article?{'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,inLanguage:lang,datePublished:article.published,dateModified:article.modified,author:{'@type':'Organization',name:'LoloBuy Sheet'},publisher:{'@type':'Organization',name:'LoloBuy Sheet'},mainEntityOfPage:new URL(p(page),Astro.site).href,citation:official(article.sourceIds).map(s=>s.url)}:undefined;
---
<Layout lang={lang} page={page} title={title} description={description} structured={structured}>
{page===''&&<>
<section class="hero container"><div class="hero-copy"><p class="eyebrow"><span></span>{t.eyebrow}</p><h1>LoloBuy spreadsheet<span class="hero-line">{t.hero1}<br/><em>{t.hero2}</em></span></h1><p class="hero-description">{t.intro}</p><form class="hero-search" action={p('spreadsheet')}><Icon name="search" size={21}/><input name="q" type="search" placeholder={t.search} aria-label={t.search}/><button type="submit">{t.searchButton} →</button></form><div class="hero-explore">{(['shoes','hoodies','accessories'] as const).map(key=><a href={`${p('spreadsheet')}?category=${key}`}>{t.categories[key]} ↗</a>)}<a class="photo-link" href={p('image-search')}><Icon name="camera" size={16}/>{t.photo}</a></div></div><div class="hero-art" aria-label={t.tagline}><div class="hero-circle"></div><span class="art-star">✳</span>{catalog.featured.map((product,i)=><a href={p('product')+'?id='+product.recordId} class={`hero-product hero-product-${i}`}><span class="hero-product-cat">{t.categories[product.category]}<Icon name="arrow" size={14}/></span><img src={product.image} alt={product.name} width="250" height="230" referrerpolicy="no-referrer"/><span class="hero-product-footer"><span>{product.name}</span><b>¥{product.priceCny}</b></span></a>)}<span class="hero-art-note">{t.source}</span></div></section>
<div class="trust-strip container"><span>{t.independent}</span><a href={p('how-it-works')}>{t.nav[1]} →</a></div><PriorityGuides lang={lang}/><Catalog lang={lang} compact/>
<section class="how-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t.findSteps}</p><h2>{t.howTitle}</h2></div><a class="text-link" href={p('how-it-works')}>{t.nav[1]} →</a></div><div class="steps-grid">{t.steps.map(([number,heading,body]:string[])=><div class="step"><span>{number}</span><h3>{heading}</h3><p>{body}</p></div>)}</div></div></section><Articles lang={lang} limit={4}/>
</>}
{page==='spreadsheet'&&<><div class="page-intro container compact-intro"><p class="eyebrow">LOLOBUY FINDS</p><h1>LoloBuy spreadsheet<span class="orange">.</span></h1><p>{t.intro}</p></div><Catalog lang={lang}/></>}
{(page==='product'||page.startsWith('product/'))&&<Product lang={lang} id={page.split('/')[1]||''}/>}
{page==='image-search'&&<section class="utility-page container"><div class="utility-icon"><Icon name="camera" size={36}/></div><h1>{t.photoTitle}</h1><p class="lead">{t.photoIntro}</p><div class="connection-note"><p>{t.photoNote}</p><a class="button" href={p('spreadsheet')}>{t.browseInstead} →</a></div></section>}
{page==='faq'&&<section class="faq-page container"><p class="eyebrow">24 {t.faqCount}</p><h1>{t.faqTitle}</h1><p class="lead">{t.faqIntro}</p><div class="faq-search"><Icon name="search"/><input type="search" aria-label={t.faqSearch} placeholder={t.faqSearch} data-faq-search/></div><div class="faq-list">{data.faqs.map((f:any)=><details data-faq><summary>{f.question}<Icon name="chevron"/></summary><div class="faq-answer"><p>{f.answer}</p><div class="source-links">{official(f.sourceIds).map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{t.officialHelp} ↗</a>)}</div></div></details>)}</div><p class="fine-print">{t.reviewed}</p><p data-no-faq hidden>{t.noQuestions}</p></section>}
{page==='how-it-works'&&<><section class="article-layout container"><div class="article-main"><p class="eyebrow">{t.guideLabel}</p><h1>{t.guideTitle}</h1><p class="lead">{t.guideIntro}</p>{t.steps.map(([n,h,b]:string[])=><section class="article-section"><span class="article-step">{n}</span><h2>{h}</h2><p>{b}</p></section>)}<a class="button" href={p('articles/how-to-order-on-lolobuy')}>{t.readArticle} →</a></div><aside><h3>{t.tagline}</h3><p>{t.intro}</p><a class="text-link" href={p('faq')}>24 {t.faqCount} →</a></aside></section><Articles lang={lang} limit={6}/></>}
{page==='guides'&&<><div class="page-intro container"><p class="eyebrow">{t.guideLabel}</p><h1>{t.guides}</h1><p>{t.guidesSub}</p></div><section class="container guide-overview"><div class="steps-grid">{t.steps.map(([n,h,b]:string[])=><a class="step" href={p('how-it-works')}><span>{n}</span><h3>{h}</h3><p>{b}</p></a>)}</div><a class="text-link" href={p('faq')}>24 {t.faqCount} →</a></section><Articles lang={lang} limit={6}/></>}
{page==='articles'&&<><div class="page-intro container"><p class="eyebrow">{t.articlesLabel}</p><h1>{t.articlesTitle}</h1><p>{t.articlesIntro}</p></div><Articles lang={lang} showHeading={false}/></>}
{article&&<article class="article-layout container long-article"><div class="article-main"><a class="text-link" href={p('articles')}>← {t.allArticles}</a><p class="eyebrow article-eyebrow">{article.category}</p><h1>{article.title}</h1><p class="lead">{article.description}</p><p class="article-date">{t.reviewedLabel} <time datetime={article.modified}>{new Intl.DateTimeFormat(lang,{dateStyle:"long",timeZone:"UTC"}).format(new Date(article.modified))}</time> · {article.readingMinutes} {t.reading}</p><div class="article-summary"><strong>{t.summary}</strong><p>{article.summary}</p></div><details class="article-toc"><summary>{t.contents}</summary><ol>{article.sections.map((s:any,i:number)=><li><a href={`#section-${i}`}>{s.heading}</a></li>)}</ol></details>{article.sections.map((s:any,i:number)=><details class="article-chapter" id={`section-${i}`} open data-chapter><summary><h2>{s.heading}</h2><Icon name="chevron" size={16}/></summary><div class="chapter-copy">{s.paragraphs.map((body:string)=><p>{body}</p>)}{s.bullets?.length>0&&<ul>{s.bullets.map((b:string)=><li>{b}</li>)}</ul>}</div></details>)}<section class="article-next"><h2>{t.nextStep}</h2>{(relatedArticles[article.slug]||[]).slice(0,2).map(slug=>data.articles.find((a:any)=>a.slug===slug)).filter(Boolean).map((a:any)=><a href={p("articles/"+a.slug)}>{a.title} →</a>)}</section><section class="article-checklist"><h2>{t.checklist}</h2><ul>{article.checklist.map((b:string)=><li>{b}</li>)}</ul></section><details class="article-sources"><summary>{t.articleSources}</summary><ul>{official(article.sourceIds).map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{t.officialHelp} · lolobuy.com ↗</a></li>)}</ul></details><p class="fine-print">{t.articleFooter}</p><a class="button" href={p('spreadsheet')}>{t.browseInstead} →</a></div><aside><p class="eyebrow">{t.related}</p>{(relatedArticles[article.slug]||[]).map(slug=>data.articles.find((a:any)=>a.slug===slug)).filter(Boolean).map((a:any)=><a class="related-article" href={p('articles/'+a.slug)}>{a.title} →</a>)}</aside></article>}
<script>
const media=matchMedia('(max-width:800px)');const chapters=[...document.querySelectorAll<HTMLDetailsElement>('[data-chapter]')];if(media.matches)chapters.forEach(c=>c.open=false);document.querySelectorAll<HTMLAnchorElement>('.article-toc a').forEach(a=>a.addEventListener('click',()=>{const target=document.querySelector<HTMLDetailsElement>(a.hash);if(target)target.open=true}));const faqSearch=document.querySelector<HTMLInputElement>('[data-faq-search]');faqSearch?.addEventListener('input',()=>{const q=faqSearch.value.trim().toLocaleLowerCase();let n=0;document.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach(d=>{const show=d.textContent!.toLocaleLowerCase().includes(q);d.hidden=!show;if(show)n++});(document.querySelector('[data-no-faq]') as HTMLElement).hidden=n>0});
</script>
</Layout>
