---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Catalog from '../components/Catalog.astro';
import Guides from '../components/Guides.astro';
import catalog from '../data/catalog.json';
import {text,pathFor,languages,articleSlugs,articles,type Language} from '../data/i18n';
export function getStaticPaths(){
 const pages=['','spreadsheet','how-it-works','guides','faq','image-search',...articleSlugs.map(s=>'guides/'+s),...catalog.products.map(p=>'product/'+p.recordId)];
 return languages.flatMap(lang=>pages.map(page=>({params:{path:[lang==='en'?'':lang,page].filter(Boolean).join('/')||undefined},props:{lang,page}})));
}
const {lang,page}=Astro.props as {lang:Language,page:string};const t=text[lang],p=(s='')=>pathFor(lang,s);const item=page.startsWith('product/')?catalog.products.find(i=>i.recordId===page.split('/')[1]):undefined;const articleIndex=articleSlugs.indexOf(page.split('/')[1]);
const title=item?`${item.name} | LoloBuy Spreadsheet`:page.startsWith('guides/')?`${t.articleTitles[articleIndex]} | LoloBuy`:page==='faq'?`FAQ | LoloBuy Spreadsheet`:page==='image-search'?`${t.photo} | LoloBuy Spreadsheet`:'LoloBuy Spreadsheet — '+(lang==='nl'?'Ontdek je volgende vondst':'Discover Your Next Find');
---
<Layout lang={lang} page={page} title={title}>
{page===''&&<>
 <section class="hero container"><div class="hero-copy"><p class="eyebrow"><span></span>{t.eyebrow}</p><h1>LoloBuy spreadsheet<span class="hero-line">{t.hero1}<br/><em>{t.hero2}</em></span></h1><p class="hero-description">{t.intro}</p><form class="hero-search" action={p('spreadsheet')}><Icon name="search" size={21}/><input name="q" type="search" placeholder={t.search} aria-label={t.search}/><button type="submit">{t.searchButton}<Icon name="arrow" size={18}/></button></form><div class="hero-explore"><span>{t.popular}</span>{(['shoes','hoodies','accessories'] as const).map(key=><a href={`${p('spreadsheet')}?category=${key}`}>{t.categories[key]} ↗</a>)}<a class="photo-link" href={p('image-search')}><Icon name="camera" size={16}/>{t.photo}</a></div></div>
 <div class="hero-art" aria-label={t.tagline}><div class="hero-circle"></div><span class="art-caption">YOUR NEXT<br/>GOOD FIND.</span><span class="art-star">✳</span>{[catalog.products[0],catalog.products[1],catalog.products[4]].map((product,i)=><a href={p(`product/${product.recordId}`)} class={`hero-product hero-product-${i}`}><span class="hero-product-cat">{t.categories[product.category as keyof typeof t.categories]}<Icon name="arrow" size={14}/></span><img src={product.image} alt={product.name} width="250" height="230" referrerpolicy="no-referrer"/><span class="hero-product-footer"><span>{product.name}</span><b>¥{product.priceCny}</b></span></a>)}<span class="hero-art-note"><Icon name="check" size={14}/>{t.source}</span></div>
 </section><div class="trust-strip container"><span><Icon name="grid" size={17}/>{t.source}</span><span><Icon name="bag" size={17}/>{t.independent}</span><a href={p('how-it-works')}>{t.nav[1]}<Icon name="arrow" size={16}/></a></div><Catalog lang={lang}/>
 <section class="how-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{lang==='nl'?'VIND. CONTROLEER. BESTEL.':'FIND. CHECK. ORDER.'}</p><h2>{t.howTitle}</h2><p>{t.howSub}</p></div><a class="text-link" href={p('how-it-works')}>{t.nav[1]}<Icon name="arrow" size={17}/></a></div><div class="steps-grid">{t.steps.map(([number,heading,body])=><div class="step"><span>{number}</span><h3>{heading}</h3><p>{body}</p></div>)}</div></div></section><Guides lang={lang}/>
 <section class="cta container"><div><p class="eyebrow">{lang==='nl'?'DE VOLGENDE VONDST IS VOOR JOU.':'THE NEXT FIND IS YOURS.'}</p><h2>{t.cta}</h2><p>{t.ctaSub}</p></div><a class="button" href={p('spreadsheet')}>{t.ctaButton}<Icon name="arrow"/></a></section>
 </>}
{page==='spreadsheet'&&<><div class="page-intro container"><p class="eyebrow">{lang==='nl'?'LOLOBUY VONDSTEN':'LOLOBUY FINDS'}</p><h1>LoloBuy spreadsheet<span class="orange">.</span></h1><p>{t.intro}</p><a class="text-link" href={p('image-search')}><Icon name="camera"/>{t.photo}<Icon name="arrow" size={17}/></a></div><Catalog lang={lang}/></>}
{item&&<><div class="container breadcrumb"><a href={p()}>{t.home}</a><span>/</span><a href={p('spreadsheet')}>Spreadsheet</a><span>/</span><span>{item.name}</span></div><section class="product-detail container"><div class="detail-gallery"><div class="detail-main-image"><img id="detail-image" src={item.images[0]||item.image} alt={item.name} width="700" height="700" referrerpolicy="no-referrer"/></div><div class="detail-thumbnails">{item.images.map((src,i)=><button data-image={src} aria-label={`${t.gallery} ${i+1}`}><img src={src} alt={`${item.name} ${i+1}`} width="80" height="80" referrerpolicy="no-referrer"/></button>)}</div><p class="fine-print">{t.aboutPhotos} · cnfanssp.com</p></div><div class="detail-copy"><p class="eyebrow">{t.categories[item.category as keyof typeof t.categories]}</p><h1>{item.name}</h1><div class="detail-price">¥{item.priceCny.toFixed(2)}<span>CNY</span></div><p class="muted">{t.sourcePrice}</p><p class="detail-note">{t.priceNote}</p><a class="button detail-buy" href={item.buyUrl} target="_blank" rel="noopener noreferrer nofollow">{t.buy}<Icon name="external"/></a><div class="detail-links"><a href={item.source} target="_blank" rel="noopener noreferrer">{t.sourceListing}<Icon name="external" size={15}/></a><a href={item.sellerUrl} target="_blank" rel="noopener noreferrer nofollow">{t.seller}<Icon name="external" size={15}/></a></div><div class="product-data"><span>{t.productId}</span><code>{item.productId}</code></div><div class="qc-note"><Icon name="camera"/><div><h3>{t.qc}</h3><p>{t.qcNote}</p></div></div><a class="text-link" href={p('how-it-works')}>{t.guideTitle}<Icon name="arrow" size={17}/></a></div></section><Guides lang={lang}/></>}
{page==='image-search'&&<section class="utility-page container"><div class="utility-icon"><Icon name="camera" size={36}/></div><p class="eyebrow">LOLOBUY IMAGE SEARCH</p><h1>{t.photoTitle}</h1><p class="lead">{t.photoIntro}</p><div class="connection-note"><span class="status-pill"><span></span>{t.photoState}</span><p>{t.photoNote}</p><a class="button" href={p('spreadsheet')}>{t.browseInstead}<Icon name="arrow"/></a></div></section>}
{page==='faq'&&<section class="faq-page container"><p class="eyebrow">LOLOBUY FAQ</p><h1>{t.faqTitle}</h1><p class="lead">{t.faqIntro}</p><div class="faq-list">{t.faq.map(([q,a],i)=><details open={i===0}><summary>{q}<Icon name="chevron"/></summary><p>{a}</p></details>)}</div></section>}
{page==='how-it-works'&&<><section class="article-layout container"><div class="article-main"><p class="eyebrow">{t.guideLabel}</p><h1>{t.guideTitle}</h1><p class="lead">{t.guideIntro}</p><p class="article-date"><Icon name="clock" size={15}/>{t.updated}</p>{t.steps.map(([n,h,b],i)=><section class="article-section"><span class="article-step">{n}</span><h2>{h}</h2><p>{b}</p><p>{articles[lang][0][i][1]}</p></section>)}<a class="button" href={p('spreadsheet')}>{t.browseInstead}<Icon name="arrow"/></a></div><aside><p class="eyebrow">LOLOBUY SPREADSHEET</p><h3>{t.tagline}</h3><p>{t.intro}</p><a class="button" href={p('spreadsheet')}>{t.browseInstead}<Icon name="arrow" size={16}/></a></aside></section><Guides lang={lang}/></>}
{page==='guides'&&<><div class="page-intro container"><p class="eyebrow">{t.guideLabel}</p><h1>{t.guides}</h1><p>{t.guidesSub}</p></div><Guides lang={lang}/></>}
{page.startsWith('guides/')&&articleIndex>=0&&<><article class="article-layout container"><div class="article-main"><a class="text-link" href={p('guides')}>← {t.allGuides}</a><p class="eyebrow article-eyebrow">{t.articleTags[articleIndex]}</p><h1>{t.articleTitles[articleIndex]}</h1><p class="article-date"><Icon name="clock" size={15}/>{t.updated}</p>{articles[lang][articleIndex].map(([heading,body])=><section class="article-section"><h2>{heading}</h2><p>{body}</p></section>)}<a class="button" href={p('spreadsheet')}>{t.browseInstead}<Icon name="arrow"/></a></div><aside><Icon name={['book','camera','bag','shirt'][articleIndex]} size={42}/><h3>{t.tagline}</h3><p>{t.intro}</p><a class="text-link" href={p('how-it-works')}>{t.nav[1]}<Icon name="arrow" size={16}/></a></aside></article><Guides lang={lang}/></>}
<script>document.querySelectorAll<HTMLButtonElement>('[data-image]').forEach(b=>b.addEventListener('click',()=>{const img=document.querySelector<HTMLImageElement>('#detail-image');if(img&&b.dataset.image)img.src=b.dataset.image;}));</script>
</Layout>
