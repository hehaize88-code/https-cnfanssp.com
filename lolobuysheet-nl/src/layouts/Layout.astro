---
import '../styles/global.css';
import {text,pathFor,languages,nativeNames,type Language} from '../data/i18n';
import Icon from '../components/Icon.astro';
import { canonicalPage, indexable } from '../lib/seo';
const {lang='en',page='',title='LoloBuy Spreadsheet',description,structured}=Astro.props;
const t=text[lang as Language],p=(path='')=>pathFor(lang,path),canonical=new URL(p(canonicalPage(page)),Astro.site).href;
const production=Astro.site?.hostname==='lolobuysheet.nl';
const links=['spreadsheet','how-it-works','guides','articles','faq'];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description||t.intro}/><meta name="robots" content={production&&indexable(page)?"index,follow,max-image-preview:large":"noindex,follow"}/><meta name="theme-color" content="#fbf9f5"/><link rel="icon" type="image/png" href="/brand/favicon.png"/><link rel="canonical" href={canonical}/>{languages.map(l=><link rel="alternate" hreflang={l} href={new URL(pathFor(l,canonicalPage(page)),Astro.site).href}/>)}<link rel="alternate" hreflang="x-default" href={new URL(pathFor('en',canonicalPage(page)),Astro.site).href}/><meta property="og:title" content={title}/><meta property="og:description" content={description||t.intro}/><meta property="og:type" content={page.startsWith('articles/')?'article':'website'}/><title>{title}</title>{structured&&<script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')}/>}</head><body>
<a class="skip-link" href="#main">{t.skip}</a>{!production&&<div class="preview-bar"><span class="preview-dot"></span><strong>{t.preview}</strong><span class="preview-note">{t.previewNote}</span><span class="preview-url">lolobuysheet.nl</span></div>}
<header class="site-header"><div class="container header-inner"><a class="brand" href={p()} aria-label={`LoloBuy ${t.home}`}><img src="/brand/lolobuy.svg" alt="LoloBuy" width="128" height="30"/><span class="brand-divider"></span><span class="brand-sheet">sheet<span class="brand-point">.</span></span></a><nav class="main-nav" aria-label={t.menu}>{links.map((l,i)=><a href={p(l)} class:list={{active:page===l||page.startsWith(l+'/')}}>{t.nav[i]}</a>)}</nav><div class="header-actions"><details class="language-picker"><summary aria-label={t.language}><Icon name="globe" size={17}/><span>{lang.toUpperCase()}</span><Icon name="chevron" size={12}/></summary><div class="language-panel"><strong>{t.languageSearch}</strong><div class="language-grid">{languages.map(l=><a href={pathFor(l,page)} data-language-link lang={l} hreflang={l} aria-current={l===lang?'true':undefined}><span>{nativeNames[l]}</span><small>{l.toUpperCase()}</small></a>)}</div></div></details><a class="button button-small" href="https://www.lolobuy.com/index" target="_blank" rel="noopener noreferrer nofollow">{t.register}<Icon name="external" size={15}/></a></div></div></header>
<main id="main"><slot/></main><footer><div class="container footer-top"><div><a class="brand" href={p()}><img src="/brand/lolobuy.svg" alt="LoloBuy" width="128" height="30"/><span class="brand-sheet">sheet.</span></a><p>{t.footer}</p></div><nav aria-label={t.menu}>{links.map((s,i)=><a href={p(s)}>{t.nav[i]}</a>)}</nav></div><div class="container footer-bottom"><span>© 2026 lolobuysheet.nl</span><span>{t.independent}</span><span>24 {t.language}</span></div></footer>
<script>document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const url=new URL(a.href);new URLSearchParams(location.search).forEach((v,k)=>url.searchParams.set(k,v));url.hash=location.hash;location.href=url.href}));document.addEventListener('click',e=>{const d=document.querySelector<HTMLDetailsElement>('.language-picker');if(d?.open&&!d.contains(e.target as Node))d.open=false});document.addEventListener('keydown',e=>{if(e.key==='Escape'){const d=document.querySelector<HTMLDetailsElement>('.language-picker');if(d)d.open=false}});</script>
</body></html>
