---
import {text,pathFor,type Language} from '../data/i18n';
const {lang='en',id=''}=Astro.props;const t=text[lang as Language];
---
<section class="container product-shell" data-product-detail data-id={id}><a class="text-link" href={pathFor(lang,'spreadsheet')}>← {t.back}</a><p class="product-loading" role="status">{t.loading}</p><div class="product-detail" hidden><div class="detail-gallery"><div class="detail-main-image"><img data-main-image alt="" width="700" height="700" referrerpolicy="no-referrer"/></div><div class="detail-thumbnails"></div><p class="fine-print">{t.aboutPhotos}</p></div><div class="detail-copy"><p class="eyebrow">{t.details}</p><h1 data-product-name></h1><div class="detail-price" data-price></div><p class="muted">{t.sourcePrice}</p><p class="detail-note">{t.priceNote}</p><a class="button detail-buy" data-buy target="_blank" rel="noopener noreferrer nofollow">{t.buy} ↗</a><div class="detail-links"><a data-original target="_blank" rel="noopener noreferrer">{t.sourceListing} ↗</a></div><div class="product-data"><span>{t.productId}</span><code data-seller-id></code></div><details class="qc-note"><summary>{t.qc}</summary><p>{t.qcNote}</p></details></div></div><script type="application/json" data-product-text set:html={JSON.stringify({productError:t.productError,retry:t.retry}).replace(/</g,'\\u003c')}/></section>
<script>
const root=document.querySelector<HTMLElement>('[data-product-detail]');if(root){const t=JSON.parse(root.querySelector('[data-product-text]')!.textContent!),id=root.dataset.id||new URLSearchParams(location.search).get('id')||'';const status=root.querySelector<HTMLElement>('.product-loading')!;async function load(){try{if(!/^\d{1,10}$/.test(id))throw Error();const r=await fetch('/api/product?id='+id);if(!r.ok)throw Error();const p=await r.json();root!.querySelector('[data-product-name]')!.textContent=p.name;root!.querySelector('[data-price]')!.textContent=Number(p.priceCny)>0?`¥${Number(p.priceCny).toFixed(2)} CNY`:"—";root!.querySelector('[data-seller-id]')!.textContent=p.productId;(root!.querySelector('[data-buy]') as HTMLAnchorElement).href=p.buyUrl;(root!.querySelector('[data-original]') as HTMLAnchorElement).href=p.source;const main=root!.querySelector<HTMLImageElement>('[data-main-image]')!;main.src=p.image;main.alt=p.name;const thumbs=root!.querySelector('.detail-thumbnails')!;thumbs.replaceChildren();for(const [i,src] of p.images.entries()){const b=document.createElement('button');b.setAttribute('aria-label',`${p.name} ${i+1}`);const img=document.createElement('img');img.src=src;img.alt=`${p.name} ${i+1}`;img.loading='lazy';img.width=70;img.height=70;img.referrerPolicy='no-referrer';b.append(img);b.onclick=()=>main.src=src;thumbs.append(b)}status.hidden=true;(root!.querySelector('.product-detail') as HTMLElement).hidden=false;document.title=p.name+' | LoloBuy Spreadsheet'}catch{status.textContent=t.productError;const b=document.createElement('button');b.className='button';b.textContent=t.retry;b.onclick=load;status.append(' ',b)}}load()}
</script>
