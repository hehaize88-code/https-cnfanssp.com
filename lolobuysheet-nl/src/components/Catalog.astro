---
import catalog from '../data/catalog-summary.json';
import {text,pathFor,type Language} from '../data/i18n';
import Icon from './Icon.astro';
const {lang='en',compact=false}=Astro.props;const t=text[lang as Language];
const labels={...t,categories:t.categories};
---
<section class="catalog-section container" id="finds" data-catalog data-product-path={pathFor(lang,'product')} data-compact={String(compact)}>
<div class="section-heading"><div><p class="eyebrow">LOLOBUY SPREADSHEET</p><h2>{t.browse}</h2><p>{t.browseSub}</p></div><div class="catalog-count"><span data-result-count>{catalog.categories.reduce((n:any,c:any)=>n+c.products,0)}</span> {t.count}<span class="small-dot"></span>CNY</div></div>
<div class="category-tabs" role="group" aria-label={t.browse}><button class="category-tab active" data-category="all" aria-pressed="true">{t.all}</button>{Object.entries(t.categories).map(([key,label])=><button class="category-tab" data-category={key} aria-pressed="false">{label}</button>)}</div>
<div class="catalog-toolbar"><div class="filter-search"><Icon name="search" size={18}/><input type="search" id="catalog-search" placeholder={t.search} aria-label={t.search}/></div><label class="sort-control"><span>{t.sort}:</span><select id="catalog-sort" aria-label={t.sort}>{['new','views','price-asc','price-desc'].map((v,i)=><option value={v}>{t.sorts[i+1]}</option>)}</select></label></div>
<p class="catalog-status" data-status role="status">{t.catalogCached} <time datetime={catalog.retrievedAt}>{catalog.retrievedAt.slice(0,10)}</time></p>
<div class="product-grid">{catalog.products.slice(0,compact?8:20).map(item=><article class="product-card"><a class="product-image" href={`${pathFor(lang,'product')}?id=${item.recordId}`}><img src={item.image} alt={item.name} loading="lazy" width="420" height="420" referrerpolicy="no-referrer"/></a><div class="product-meta"><p>{t.categories[item.category]}</p><a class="product-title" href={`${pathFor(lang,'product')}?id=${item.recordId}`}>{item.name}</a><div class="product-bottom"><span class="price">{item.priceCny>0?`¥${item.priceCny.toFixed(2)}`:"—"}<small>CNY</small></span><a href={`${pathFor(lang,'product')}?id=${item.recordId}`} aria-label={`${t.view}: ${item.name}`}>↗</a></div></div></article>)}</div>
<div class="empty-state" hidden data-empty><h3>{t.empty}</h3><button class="button" data-reset>{t.reset}</button></div>
<div class="catalog-bottom"><p class="source-note">{t.source}</p><nav class="pagination" aria-label={t.page}><button data-prev aria-label={t.previous}>←</button><div data-page-numbers></div><button data-next aria-label={t.next}>→</button></nav><form class="page-jump"><label>{t.jump}<input type="number" min="1" value="1" inputmode="numeric" aria-label={t.jump}/></label><button type="submit">{t.go}</button></form></div>
{compact&&<a class="button catalog-all" href={pathFor(lang,'spreadsheet')}>{t.ctaButton} →</a>}
<p class="fine-print">{t.priceNote}</p>
<script type="application/json" data-catalog-text set:html={JSON.stringify(labels).replace(/</g,'\\u003c')}/>
</section>
<script>
import {initCatalog} from '../scripts/catalog-client';initCatalog();
</script>
