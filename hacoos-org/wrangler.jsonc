{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hacoos-org",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "hacoos.org",
      "custom_domain": true
    },
    {
      "pattern": "www.hacoos.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
