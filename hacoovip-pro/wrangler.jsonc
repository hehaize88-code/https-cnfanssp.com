{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hacoovip-pro",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
